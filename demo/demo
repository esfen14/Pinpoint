#!/usr/bin/env bash
# One defense demo entry point; initially read-only until the isolation spike.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ "${1:-}" == "presenter" ]]; then
    shift
    exec python3 -I "$root/demo/targets/presenter.py" "$@"
fi
exec python3 -I "$root/demo/targets/controller.py" "$@"
